import csv

students=[]

with open("Std.csv","r") as fin:
    reader = csv.reader(fin)# read all student names and adress
    for name,home in reader:
        students.append( {"name":name,"home":home})

def gethome(student):
    return student['home']

for std in sorted(students,key=gethome):
    print(f"{std['name']} is from {std['home']}")

