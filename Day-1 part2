import re 

name = input("Enter name ")

match = re.search(r"^(.+), (.+)$", name) # shah, simi  we wnat to capture first and last name thats why(.+)

if match:
    last, first = match.groups()
    name = f"{first} {last}"
    print(f"Hello {name}")

