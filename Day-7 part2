    def sort(cls,name):  # cls is the class we use cls coz it will collide with the main class dont use self coz in self they are instance variable but here these are the variables of the class itself  variable that belongs to a particular object (instance) of a class.
        print(name,"lives in ",random.choice(cls.houses))
# instace varables use with self and cls used with class fun 
