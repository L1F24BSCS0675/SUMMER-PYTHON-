# wizard class is the super class and the student and profesor class is inherited from 
# student and the professor class   super().__init__(name)   means super tells that 
# find its parent wizard is the parent then wizard.__init__(name)  super take place of
# the wizard and then the wizard __init__ fun is called 
# we inherit just coz of the name also include in student and also in the prof and also in 
# wizard so to avoid redundency we inherit both woth wizard so now we dont need to assign name 
# seprately in both student and proffessor class
class Wizard:
    def __init__(self,name):
        self.name=name

class Student(Wizard):            #student inherit from wizard it means student can use things from wizard
    def __init__(self,name,home):  
        super().__init__(name)
        self.home=home

class proffesor(Wizard):         #professor inherit from wizard
    def __init__(self,name,sub):
        super().__init__(name)
        self.sub=sub

wz=Wizard("Ali")
# first of all the student obj is created then go inside at line 57 from here it will call wizard.__init__(name)   fun 
#  and go on the line 53 and call the init fun of the wizard class after assigning name at line 54 come 
# back on the line 59 and assign the home 
std=Student("Simi","skp")
prof=proffesor("Shah","maths")


print(std.name)
print(std.home)

print(prof.name)
print(prof.sub)

print(wz.name)



class Vault:
    def __init__(self,a,b,c):
        self.a=a
        self.b=b
        self.c=c

    def __str__(self):
        return f"{self.a},{self.b},{self.c}"


    def __add__(self, other):   # operator overload of +
        newa = self.a+other.a
        newb = self.b+other.b
        newc =self.c+other.c
        return Vault(newa,newb,newc)    # new obj is created and the para constructor run here 




v1=Vault(1,2,3)
v2=Vault(11,22,3)
total=v1+v2
print(total)
