#    START → something → @ → something → .edu → END.  re.search(r"^.+@.+\.edu$",input)
#  if the user enter simi@@@123.edu than out code say it is valid but its not 
# thats ehy i ma using []  set of characters if we want to enter just these letters [abs]   and  
#   [^] complement the set we want not that letter [^123]
import re
input=input("Enter a newwwww email ")
if re.search(r"^.+@.+\.edu$",input):# search(pattern,string,flags=0) syntax of search fun 
    print("VALID")
else:
    print("INVALID") 
