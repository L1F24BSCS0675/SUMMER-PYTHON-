#### NESTED LOOP FOR PATTERN TO PRINT SQUARE OF 3 BY 3

def main():
    p_row(3)

def p_row(n):
    for i in range(n):  # print row 
        for j in range(n):  # print column 
            print("*",end="") # override the end="backlacsh n"

        print() # print new line # part of outer for loop 8 spaces not 4 

