class Student:

    def __init__(self, name, age):# initialize the content of the obj # self is the current calling object    
        self.name = name  # 4 spaces of class and 4 of fun #object attribute
        self.age = age  #object attribute


    def __str__(self):
            return(f"{self.name} has {self.age} age.")

    
# @property → controls getting/reading the value
    @property   # used to access the atribute of the class when call getname than dont need to use ()
    def name(self): #getter
        return self._name
 
#@age.setter → controls setting/changing the value
#when the atribute and property both have the same names then use ._ represent 
#age             → the value coming into the function
#self._age       → where we store that value
# age = property
# _age = internal stored value
# when we write std.age=12  then autometically the setter fun is called and we dont need to call it manually 
# when the fun run and go on the line 38 if we write self.age=age then here we say std.age=12  when this line 
# is written then the setter is called self.age=age  is the same syntax so again the setter fun is called
# and infinite loop is called thats why we write the self._age=age so that again infinite loop is not run thats 
# the purpose of the _age 
# imp point is that the order of getter and seteer must be true like first getter than setter fun  setter and 
# setter fun name must same in getter and setter with the atribute otherwise error
# here getter and setter work in conjunction getter and setter have same names 
#     self._age=age        its just like        this->self.age=age in c++

    @name.setter
    def name(self,name): #setter
        self._name=name  ### here the setter fun is again called   self.age=12 is the syntax  thts whyt use the self._age=age 

  

    

